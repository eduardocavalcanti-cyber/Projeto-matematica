{
    "name": "projeto/projeto-matematica",
    "description": "Calculadora de Algebra Linear com Testes Unitarios PHPUnit",
    "type": "project",
    "require": {
        "php": "^8.2 || ^8.3 || ^8.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    }
}